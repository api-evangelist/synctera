            }
          },
          "docs": "Create an account template. An account template is need when create an account in a lead mode\n"
        },
        {
          "info": {
            "name": "Get account template",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.synctera.com/v0/accounts/templates/:template_id",
            "params": [
              {
                "name": "template_id",
