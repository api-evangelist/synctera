          "docs": "Update account template\n"
        },
        {
          "info": {
            "name": "Delete account template",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.synctera.com/v0/accounts/templates/:template_id",
            "params": [
              {
                "name": "template_id",
                "value": "",
