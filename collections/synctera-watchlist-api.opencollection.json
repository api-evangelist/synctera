                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "customer_id",
                "value": "",
                "type": "path",
                "description": "The customer's unique identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Suppress entity alert"
        }
      ]
    }
  ],
  "bundled": true
}