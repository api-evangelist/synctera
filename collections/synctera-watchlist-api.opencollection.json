{
  "opencollection": "1.0.0",
  "info": {
    "name": "Synctera Accounts Watchlist API",
    "version": "0.20.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Watchlist",
        "type": "folder"
      },
      "items": [
