        },
        {
          "info": {
            "name": "Update watchlist monitoring subscription",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.synctera.com/v0/customers/:customer_id/watchlists/subscriptions/:subscription_id",
            "params": [
              {
                "name": "customer_id",
                "value": "",
                "type": "path",
                "description": "The customer's unique identifier"
              },
              {
                "name": "subscription_id",
                "value": "",
                "type": "path",
                "description": "Watchlist monitoring subscription ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update watchlist monitoring subscription"
        },
        {
          "info": {
            "name": "Suppress entity alert",
            "type": "http"
          },
          "http": {
            "method": "POST",
